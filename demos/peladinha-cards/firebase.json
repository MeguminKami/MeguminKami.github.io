{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": { "rules": "storage.rules" },
  "functions": [
    {
      "source": ".",
      "codebase": "peladinhas",
      "ignore": [
        "node_modules",
        ".git",
        "tests",
        "scripts",
        "css",
        "assets",
        "README.md",
        ".codex",
        ".agents",
        "js/config.js",
        "playwright-report",
        "test-results",
        "*-debug.log",
        "firebase.backend.json",
        ".firebase",
        ".env*"
      ]
    }
  ],
  "emulators": {
    "firestore": { "port": 8085 },
    "functions": { "port": 5001 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false }
  }
}
