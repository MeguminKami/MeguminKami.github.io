rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function active() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == false; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function admin() { return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
  function attrs() { return ['pace','shooting','passing','dribbling','defending','physical','goalkeeping','stamina','vision','positioning','teamwork','composure']; }
  function optionalRating(r,k,max) { return !(k in r) || (r[k] is int && r[k]>=0 && r[k]<=max); }
  function validInitial(r) { return r is map && r.keys().hasOnly(attrs()) && optionalRating(r,'pace',20) && optionalRating(r,'shooting',20) && optionalRating(r,'passing',20) && optionalRating(r,'dribbling',20) && optionalRating(r,'defending',20) && optionalRating(r,'physical',20) && optionalRating(r,'goalkeeping',20) && optionalRating(r,'stamina',20) && optionalRating(r,'vision',20) && optionalRating(r,'positioning',20) && optionalRating(r,'teamwork',20) && optionalRating(r,'composure',20); }
  function validFeedback(r) { return r is map && r.keys().hasOnly(['overall','attack','passing','defense','physical','goalkeeping']) && optionalRating(r,'overall',5) && optionalRating(r,'attack',5) && optionalRating(r,'passing',5) && optionalRating(r,'defense',5) && optionalRating(r,'physical',5) && (!('goalkeeping' in r) || r.goalkeeping==null || optionalRating(r,'goalkeeping',5)); }
  function completeFeedback(r) { return r.keys().hasAll(['overall','attack','passing','defense','physical','goalkeeping']); }
  function validProfile(p) { return p.displayName is string && p.displayName.size()<=30 && p.countryCode is string && p.countryCode.matches('^[A-Z]{2}$') && p.country is string && p.photoURL is string && p.photoURL.size()<=2000 && (!('heightCm' in p) || (p.heightCm is int && p.heightCm>=120 && p.heightCm<=230)) && (!('weightKg' in p) || p.weightKg==null || (p.weightKg is number && p.weightKg>=30 && p.weightKg<=250)) && (!('birthDate' in p) || (p.birthDate is string && p.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) && (!('preferredFoot' in p) || p.preferredFoot in ['right','left','both']) && (!('primaryPosition' in p) || p.primaryPosition in ['GR','DEF','ALA','MED','AV']) && (!('secondaryPositions' in p) || (p.secondaryPositions is list && p.secondaryPositions.toSet().hasOnly(['GR','DEF','ALA','MED','AV']))) && (!('shirtNumber' in p) || p.shirtNumber==null || (p.shirtNumber is int && p.shirtNumber>=0 && p.shirtNumber<=99)) && (!('city' in p) || (p.city is string && p.city.size()<=60)) && (!('playerStyle' in p) || (p.playerStyle is string && p.playerStyle.size()<=80)); }
  function teamIds(g) { return g.teamA.starters.concat(g.teamA.bench).concat(g.teamB.starters).concat(g.teamB.bench); }
  function validGame(g) { return (!('youtubeVideoId' in g) || (g.youtubeVideoId is string && (g.youtubeVideoId=='' || g.youtubeVideoId.matches('^[A-Za-z0-9_-]{11}.hasOnly(['youtubeVideoId','title','location','notes','scheduledAt','teamA','teamB','score','status','creatorId','createdAt','updatedAt','closedAt','closedBy']) && g.title is string && g.title.size()>0 && g.title.size()<=80 && g.location is string && g.location.size()<=120 && g.notes is string && g.notes.size()<=1000 && g.scheduledAt is timestamp && g.status in ['draft','open','closed'] && g.teamA.keys().hasOnly(['starters','bench']) && g.teamB.keys().hasOnly(['starters','bench']) && g.teamA.starters is list && g.teamA.bench is list && g.teamB.starters is list && g.teamB.bench is list && g.teamA.starters.size()<=5 && g.teamB.starters.size()<=5 && teamIds(g).size()<=60 && teamIds(g).size()==teamIds(g).toSet().size() && g.score.keys().hasOnly(['teamA','teamB']) && g.score.teamA is int && g.score.teamB is int && g.score.teamA>=0 && g.score.teamB>=0 && g.score.teamA<=999 && g.score.teamB<=999 && (g.status!='closed' || (g.teamA.starters.size()>0 && g.teamB.starters.size()>0 && g.closedAt is timestamp)); })))) && g.keys().hasOnly(['youtubeVideoId','title','location','notes','scheduledAt','teamA','teamB','score','status','creatorId','createdAt','updatedAt','closedAt','closedBy']) && g.title is string && g.title.size()>0 && g.title.size()<=80 && g.location is string && g.location.size()<=120 && g.notes is string && g.notes.size()<=1000 && g.scheduledAt is timestamp && g.status in ['draft','open','closed'] && g.teamA.keys().hasOnly(['starters','bench']) && g.teamB.keys().hasOnly(['starters','bench']) && g.teamA.starters is list && g.teamA.bench is list && g.teamB.starters is list && g.teamB.bench is list && g.teamA.starters.size()<=5 && g.teamB.starters.size()<=5 && teamIds(g).size()<=60 && teamIds(g).size()==teamIds(g).toSet().size() && g.score.keys().hasOnly(['teamA','teamB']) && g.score.teamA is int && g.score.teamB is int && g.score.teamA>=0 && g.score.teamB>=0 && g.score.teamA<=999 && g.score.teamB<=999 && (g.status!='closed' || (g.teamA.starters.size()>0 && g.teamB.starters.size()>0 && g.closedAt is timestamp)); }
  match /users/{uid} {
   allow read: if active() || owner(uid);
   allow create: if owner(uid) && request.resource.data.uid==uid && request.resource.data.role=='member' && request.resource.data.disabled==false && request.resource.data.username.matches('^[a-z0-9_.-]{3,20}$') && request.auth.token.email==request.resource.data.username+'@auth.weeklyfc.app' && validProfile(request.resource.data) && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   allow update: if validProfile(request.resource.data) && request.resource.data.uid==resource.data.uid && request.resource.data.username==resource.data.username && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.updatedAt==request.time && ((admin() && request.resource.data.role in ['member','admin'] && (uid!=request.auth.uid || request.resource.data.role=='admin')) || (active() && owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','country','countryCode','photoURL','birthDate','heightCm','weightKg','preferredFoot','primaryPosition','secondaryPositions','shirtNumber','city','playerStyle','profileCompleted','updatedAt'])));
   allow delete: if false;
   match /cardHistory/{week} { allow read: if active(); allow write: if false; }
   match /notifications/{id} {
    allow read: if owner(uid) && active();
    allow create: if owner(uid) && active() && id.matches('^mission-.*') && request.resource.data.keys().hasOnly(['type','title','body','href','read','createdAt']) && request.resource.data.type in ['NEW_MISSION','NEW_PLAYER_TO_RATE','RATING_REQUIRED'] && request.resource.data.title is string && request.resource.data.title.size()<=150 && request.resource.data.body is string && request.resource.data.body.size()<=500 && request.resource.data.href.matches('^#/.*') && request.resource.data.read==false && request.resource.data.createdAt==request.time;
    allow update: if owner(uid) && active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
   }
  }
  // A autoavaliação é pública; as avaliações externas permanecem privadas.
  match /initialRatings/{uid} {
   allow read: if active();
   allow create: if (owner(uid)&&active() || admin()) && request.resource.data.keys().hasOnly(['uid','ratings20','completed','createdAt','updatedAt']) && request.resource.data.uid==uid && validInitial(request.resource.data.ratings20) && request.resource.data.completed==request.resource.data.ratings20.keys().hasAll(attrs()) && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   allow update: if (owner(uid)&&active() || admin()) && request.resource.data.uid==resource.data.uid && request.resource.data.createdAt==resource.data.createdAt && validInitial(request.resource.data.ratings20) && request.resource.data.completed==request.resource.data.ratings20.keys().hasAll(attrs()) && request.resource.data.updatedAt==request.time && request.resource.data.keys().hasOnly(['uid','ratings20','completed','createdAt','updatedAt']);
  }
  match /communityRatings/{id} {
   allow read: if admin() || (active() && resource.data.raterId==request.auth.uid);
   allow get: if active() && id.matches('^'+request.auth.uid+'_.*') && !exists(/databases/$(database)/documents/communityRatings/$(id));
   function validVote() { let d=request.resource.data; return d.keys().hasOnly(['raterId','targetId','ratings20','submitted','createdAt','updatedAt','submittedAt']) && d.raterId==request.auth.uid && d.targetId!=request.auth.uid && exists(/databases/$(database)/documents/users/$(d.targetId)) && id==d.raterId+'_'+d.targetId && validInitial(d.ratings20) && d.submitted is bool && (!d.submitted || d.ratings20.keys().hasAll(attrs())) && d.updatedAt==request.time && (!d.submitted || d.submittedAt==request.time); }
   allow create: if active() && validVote() && request.resource.data.createdAt==request.time;
   allow update: if active() && validVote() && (!resource.data.submitted || admin()) && request.resource.data.raterId==resource.data.raterId && request.resource.data.targetId==resource.data.targetId && request.resource.data.createdAt==resource.data.createdAt;
  }
  match /communitySummaries/{uid} { allow read: if active(); allow write: if false; }
  match /gameSummaries/{gid} { allow read: if active(); allow write: if false; }
  match /games/{gid} {
   allow read: if active();
   allow create: if active() && validGame(request.resource.data) && request.resource.data.creatorId==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time && (request.resource.data.status!='closed' || request.resource.data.closedBy==request.auth.uid && request.resource.data.closedAt==request.time);
   allow update: if active() && validGame(request.resource.data) && request.resource.data.creatorId==resource.data.creatorId && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.updatedAt==request.time && (admin() || request.auth.uid==resource.data.creatorId && resource.data.status!='closed') && (request.resource.data.closedAt==resource.data.closedAt || request.resource.data.closedAt==request.time) && (request.resource.data.status!='closed' || resource.data.status=='closed' || request.resource.data.closedBy==request.auth.uid);
   allow delete: if false;
   match /feedback/{id} {
    allow read: if admin() || (active() && resource.data.raterId==request.auth.uid);
    allow get: if active() && id.matches('^'+request.auth.uid+'_.*') && !exists(/databases/$(database)/documents/games/$(gid)/feedback/$(id));
    function validVote() { let d=request.resource.data; let g=get(/databases/$(database)/documents/games/$(gid)).data; return d.keys().hasOnly(['gameId','raterId','targetId','ratings','submitted','createdAt','updatedAt','submittedAt']) && g.status=='closed' && d.gameId==gid && d.raterId==request.auth.uid && d.targetId!=d.raterId && d.raterId in teamIds(g) && d.targetId in teamIds(g) && id==d.raterId+'_'+d.targetId && validFeedback(d.ratings) && d.submitted is bool && (!d.submitted || completeFeedback(d.ratings)) && d.updatedAt==request.time && (!d.submitted || d.submittedAt==request.time); }
    allow create: if active() && validVote() && request.resource.data.createdAt==request.time;
    allow update: if active() && validVote() && (!resource.data.submitted || admin()) && request.resource.data.gameId==resource.data.gameId && request.resource.data.raterId==resource.data.raterId && request.resource.data.targetId==resource.data.targetId && request.resource.data.createdAt==resource.data.createdAt;
   }
  }
  match /cardThemes/{id} { allow read: if admin(); allow write: if false; }
  match /ratingCorrections/{id} { allow read: if admin(); allow write: if false; }
 }
}
