{
  "name": "peladinhas-cards",
  "private": true,
  "type": "module",
  "main": "functions/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test tests/logic.test.js tests/youtube.test.js",
    "test:rules": "firebase emulators:exec --project demo-peladinhas-rules --only firestore \"node --test tests/firestore.rules.test.js\"",
    "test:backend": "firebase emulators:exec --config firebase.backend.json --project demo-peladinhas-backend --only firestore \"node --test tests/backend.test.js\"",
    "test:ui": "node tests/browser.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0",
    "playwright": "^1.50.0",
    "prettier": "^3.9.9"
  }
}
